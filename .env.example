# ===== Docker 连接 =====
# 若绿联NAS docker socket不在默认路径，修改此变量
DOCKER_SOCKET=unix:///var/run/docker.sock

# ===== 日志存储 =====
# 容器内的路径（已在compose里把 ./logs 挂载到这里，一般不用改）
LOG_STORAGE_PATH=/app/logs
# 日志保留天数（超过此天数的日志文件+数据库记录会被自动清理）
LOG_RETENTION_DAYS=30

# ===== 收集器 =====
# 全量扫瞄容器的间隔（秒）
COLLECT_INTERVAL_SEC=60
# 不需要收集日志的容器名（逗号分隔），默认排除自身
EXCLUDE_CONTAINERS=dxp4800-log-collector

# ===== Web 界面 =====
WEB_HOST=0.0.0.0
WEB_PORT=5000
# 登录账号密码，请及时修改默认值
WEB_USERNAME=admin
WEB_PASSWORD=ChangeMe123!

# ===== 数据库 =====
DB_PATH=/app/data/logs.db

# ===== 企业微信通知（监控错误日志，推送到企业微信） =====
# 总开关：true 启用 / false 关闭（默认关闭，配置好下面三项再开启）
WECHAT_WORK_ENABLED=false
# 企业ID（企业微信管理后台 -> 我的企业 -> 企业信息 -> 企业ID）
WECHAT_WORK_CORPID=
# 应用Secret（自建应用 -> Secret；注意：仅创建时可见，需记好）
WECHAT_WORK_CORPSECRET=
# 应用AgentId（自建应用 -> AgentId，整数）
WECHAT_WORK_AGENTID=0
# 接收人：@all 表示全员，也可填指定用户ID，多个用 | 分隔（如 user1|user2）
WECHAT_WORK_TOUSER=@all
# 错误关键字（逗号分隔）：日志命中任一关键字就触发通知
WECHAT_WORK_ERROR_KEYWORDS=ERROR,ERR,FATAL,PANIC,Exception,Traceback,Failed,failed,Out of memory,OOM
# 单容器通知冷却（秒）：同一容器在该窗口内只推一条，避免错误日志洪水
WECHAT_WORK_COOLDOWN_SEC=60
# 单条通知正文最大长度（企业微信 text 消息上限 2048 字节，留点给前缀）
WECHAT_WORK_MAX_CONTENT_LEN=1500
# 可选：只监控指定容器（逗号分隔，留空=全部容器），如 go2rtc,frpc
WECHAT_WORK_INCLUDE_CONTAINERS=
# 首次启动时，首次全量拉到的 N 天前历史错误日志要不要也推送？
#   false = 只推"本次启动之后新产生"的错误（默认，推荐）
#   true  = 老错误也推（首次启动容易收到几十条老日志）
WECHAT_WORK_NOTIFY_ON_INIT=false
# 可选：HTTP 代理（NAS 不能直连公网时使用），如 http://192.168.31.1:7890
WECHAT_WORK_PROXY_URL=

# ===== 企业微信配置步骤（参考） =====
# 1. 登录企业微信管理后台 https://work.weixin.qq.com/
# 2. "我的企业" -> "企业信息" -> 复制 "企业ID" 填到 WECHAT_WORK_CORPID
# 3. "应用管理" -> "自建" -> "创建应用"（随意填名称、上传 logo、选可见部门/成员）
# 4. 进入刚创建的应用：
#    - 复制 "AgentId" 填到 WECHAT_WORK_AGENTID
#    - 点 "Secret" 后面的 "查看" -> 发送到手机 -> 复制填到 WECHAT_WORK_CORPSECRET
# 5. "我的企业" -> "微信插件" 邀请成员加入企业（@all 才能收到通知）
# 6. 把 WECHAT_WORK_ENABLED 改为 true，重启容器即可。
# 7. 进 Web 界面（默认 http://NAS_IP:5000），登录后调
#    POST /api/wechat/test  (body 留空或 {"message":"hello"}) 验证能否收到测试消息。
