# ===== Docker 连接 =====
# 若绿联NAS docker socket不在默认路径，修改此变量
DOCKER_SOCKET=unix:///var/run/docker.sock

# ===== 日志存储 =====
# 容器内的路径（已在compose里把 ./logs 挂载到这里，一般不用改）
LOG_STORAGE_PATH=/app/logs
# 日志保留天数（超过此天数的日志文件+数据库记录会被自动清理）
LOG_RETENTION_DAYS=30

# ===== 收集器 =====
# 全量扫瞄容器的间隔（秒）
COLLECT_INTERVAL_SEC=60
# 不需要收集日志的容器名（逗号分隔），默认排除自身
EXCLUDE_CONTAINERS=dxp4800-log-collector

# ===== Web 界面 =====
WEB_HOST=0.0.0.0
WEB_PORT=5000
# 登录账号密码，请及时修改默认值
WEB_USERNAME=admin
WEB_PASSWORD=ChangeMe123!

# ===== 数据库 =====
DB_PATH=/app/data/logs.db
